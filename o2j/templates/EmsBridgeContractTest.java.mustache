  private Exchange exchange(
      String destination, String body, Map<String, String> properties, String correlationId) {
    return jms.execute(
        session -> {
          TemporaryQueue replyTo = session.createTemporaryQueue();
          MessageProducer producer = session.createProducer(session.createQueue(destination));
          TextMessage request = session.createTextMessage(body);
          request.setJMSReplyTo(replyTo);
          request.setJMSCorrelationID(correlationId);
          for (Map.Entry<String, String> property : properties.entrySet()) {
            request.setStringProperty(property.getKey(), property.getValue());
          }
          producer.send(request);
          MessageConsumer consumer = session.createConsumer(replyTo);
          Message reply = consumer.receive(REPLY_WAIT_MILLIS);
          consumer.close();
          producer.close();
          return new Exchange(request.getJMSMessageID(), reply);
        },
        true);
  }

  private static String text(Message message) throws Exception {
    return message instanceof TextMessage text ? text.getText() : null;
  }
