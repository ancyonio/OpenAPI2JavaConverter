package {{base_package}}.ems;

import java.util.Optional;
import org.springframework.core.env.Environment;
import org.springframework.stereotype.Component;

/**
 * The bearer token the EMS bridge presents when it calls the REST API.
 *
 * <p>Scaffolded once by o2j; yours to edit and never overwritten. The default reads a static
 * token from {@code o2j.ems.bearer-token} (set it from a secret, never in a file). Replace it
 * with an OAuth2 client-credentials flow for production: the bridge is a client of this API
 * and should hold the scopes of the operations it bridges, no more.
 */
@Component
public class EmsBridgeCredentials {

  private final Environment environment;

  public EmsBridgeCredentials(Environment environment) {
    this.environment = environment;
  }

  public Optional<String> bearerToken() {
    return Optional.ofNullable(environment.getProperty("o2j.ems.bearer-token"))
        .filter(token -> !token.isBlank());
  }
}
