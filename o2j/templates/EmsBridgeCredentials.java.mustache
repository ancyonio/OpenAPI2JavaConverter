package {{base_package}}.ems;

import java.net.http.HttpClient;
import java.nio.charset.StandardCharsets;
import java.time.Clock;
import java.time.Duration;
import java.time.Instant;
import java.util.Map;
import java.util.Optional;
import org.springframework.core.ParameterizedTypeReference;
import org.springframework.core.env.Environment;
import org.springframework.http.MediaType;
import org.springframework.http.client.JdkClientHttpRequestFactory;
import org.springframework.stereotype.Component;
import org.springframework.util.LinkedMultiValueMap;
import org.springframework.util.MultiValueMap;
import org.springframework.web.client.RestClient;

/**
 * The bearer token the EMS bridge presents when it calls the REST API.
 *
 * <p>Scaffolded once by o2j; yours to edit and never overwritten.
 *
 * <p>With {@code o2j.ems.oauth2.token-uri} set, the token comes from the OAuth2
 * client-credentials grant ({@code client_secret_basic}) and is cached until shortly before it
 * expires. The bridge is a client of this API, so give its client registration the scopes of
 * the operations it bridges and no more. Without a token URI it falls back to the static
 * {@code o2j.ems.bearer-token}, which is meant for tests. Secrets come from the environment,
 * never from a file.
 *
 * <p>A failure to obtain a token throws; the bridge turns that into a 500 fault reply, so a
 * requester is never left waiting.
 */
@Component
public class EmsBridgeCredentials {

  /** Refresh this long before expiry, so a token never expires in flight. */
  static final Duration EXPIRY_MARGIN = Duration.ofSeconds(30);

  private static final Duration TIMEOUT = Duration.ofSeconds(5);
  private static final long DEFAULT_EXPIRES_IN_SECONDS = 300;
  private static final ParameterizedTypeReference<Map<String, Object>> JSON_OBJECT =
      new ParameterizedTypeReference<>() {};

  private record CachedToken(String value, Instant refreshAt) {}

  private final Environment environment;
  private final Clock clock;
  private final RestClient tokenClient;
  private volatile CachedToken cached;

  public EmsBridgeCredentials(Environment environment, Clock clock) {
    this.environment = environment;
    this.clock = clock;
    HttpClient http = HttpClient.newBuilder().connectTimeout(TIMEOUT).build();
    JdkClientHttpRequestFactory factory = new JdkClientHttpRequestFactory(http);
    factory.setReadTimeout(TIMEOUT);
    this.tokenClient = RestClient.builder().requestFactory(factory).build();
  }

  public Optional<String> bearerToken() {
    String tokenUri = property("token-uri");
    if (tokenUri == null) {
      return Optional.ofNullable(environment.getProperty("o2j.ems.bearer-token"))
          .filter(token -> !token.isBlank());
    }
    Instant now = clock.instant();
    CachedToken current = cached;
    if (current == null || !now.isBefore(current.refreshAt())) {
      synchronized (this) {
        current = cached;
        if (current == null || !now.isBefore(current.refreshAt())) {
          current = fetch(tokenUri, now);
          cached = current;
        }
      }
    }
    return Optional.of(current.value());
  }

  private CachedToken fetch(String tokenUri, Instant now) {
    String clientId = required("client-id");
    String clientSecret = required("client-secret");
    MultiValueMap<String, String> form = new LinkedMultiValueMap<>();
    form.add("grant_type", "client_credentials");
    String scope = property("scope");
    if (scope != null) {
      form.add("scope", scope);
    }
    Map<String, Object> response =
        tokenClient
            .post()
            .uri(tokenUri)
            .contentType(MediaType.APPLICATION_FORM_URLENCODED)
            .headers(headers -> headers.setBasicAuth(clientId, clientSecret, StandardCharsets.UTF_8))
            .body(form)
            .retrieve()
            .body(JSON_OBJECT);
    Object token = response == null ? null : response.get("access_token");
    if (!(token instanceof String value) || value.isBlank()) {
      throw new IllegalStateException("token endpoint returned no access_token");
    }
    long expiresIn =
        response.get("expires_in") instanceof Number seconds
            ? seconds.longValue()
            : DEFAULT_EXPIRES_IN_SECONDS;
    Instant refreshAt = now.plusSeconds(expiresIn).minus(EXPIRY_MARGIN);
    return new CachedToken(value, refreshAt);
  }

  private String property(String name) {
    String value = environment.getProperty("o2j.ems.oauth2." + name);
    return value == null || value.isBlank() ? null : value;
  }

  private String required(String name) {
    String value = property(name);
    if (value == null) {
      throw new IllegalStateException(
          "o2j.ems.oauth2." + name + " must be set when o2j.ems.oauth2.token-uri is");
    }
    return value;
  }
}
