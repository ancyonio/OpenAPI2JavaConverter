public final class EmsRoutes {

  private EmsRoutes() {}

  /** How a reply is correlated with its request. */
  public enum Correlation {
    /** Reply JMSCorrelationID = request JMSMessageID (the usual TIBCO request/reply). */
    MESSAGE_ID,
    /** Reply JMSCorrelationID = request JMSCorrelationID (shared reply queues). */
    CORRELATION_ID
  }

  /** Where one HTTP parameter of the operation comes from in the request message. */
  public record Param(String name, String in, String source) {}

  /** One bridged queue. */
  public record Route(
      String destination,
      String operationId,
      String method,
      String path,
      Correlation correlation,
      long replyTimeoutMillis,
      boolean hasBody,
      List<Param> params,
      Map<Integer, String> faults) {}

  public static final List<Route> ALL =
      List.of({{#ems_routes}}
          new Route(
              "{{destination}}",
              "{{operation_id}}",
              "{{method}}",
              "{{path}}",
              Correlation.{{correlation}},
              {{timeout}}L,
              {{has_body}},
              List.of({{{params}}}),
              Map.ofEntries({{{faults}}})){{^last}},{{/last}}{{/ems_routes}});
}
