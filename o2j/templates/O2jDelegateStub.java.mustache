package {{base_package}}.contract;

import java.lang.reflect.InvocationHandler;
import java.lang.reflect.Method;
import java.lang.reflect.ParameterizedType;
import java.lang.reflect.Proxy;
import java.lang.reflect.Type;
import java.util.List;
import java.util.Locale;
import java.util.Map;
import java.util.Optional;
import java.util.concurrent.ConcurrentHashMap;
import java.util.concurrent.CopyOnWriteArrayList;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.context.request.RequestAttributes;
import org.springframework.web.context.request.RequestContextHolder;

import {{base_package}}.error.DomainException;
{{#use_jackson_3}}import tools.jackson.databind.ObjectMapper;
{{/use_jackson_3}}{{^use_jackson_3}}import com.fasterxml.jackson.databind.ObjectMapper;
{{/use_jackson_3}}

/**
 * A stand-in for any generated {@code *ApiDelegate}, driven by operationId.
 *
 * <p>GENERATED by o2j. Do not edit: rewritten on every run.
 *
 * <p>It is a JDK proxy rather than a Mockito mock so it needs no knowledge of each delegate
 * method's parameter list, which openapi-generator orders by its own rules. A stubbed body is
 * given as JSON and deserialized into the method's real return type, so the response the test
 * sees went through the generated DTO and Jackson exactly as production output does.
 *
 * <p>Every request it answers is marked with {@value #STUBBED_ATTRIBUTE}, so {@link
 * O2jConformanceRecorder} can tell a stubbed response from one the real service produced. Only
 * the latter proves the implementation honours the contract.
 */
public final class O2jDelegateStub {

  /** Request attribute set on every request this stub answers. */
  public static final String STUBBED_ATTRIBUTE = "o2j.stubbed";

  private record Behaviour(int status, String json, RuntimeException failure, long delayMillis) {}

  private final ObjectMapper mapper;
  private final Map<String, Behaviour> behaviours = new ConcurrentHashMap<>();
  private final List<String> calls = new CopyOnWriteArrayList<>();

  public O2jDelegateStub(ObjectMapper mapper) {
    this.mapper = mapper;
  }

  /** Forget all stubbing and recorded calls. */
  public void reset() {
    behaviours.clear();
    calls.clear();
  }

  /** Answer {@code operationId} with {@code status} and, if non-null, a JSON body. */
  public void respond(String operationId, int status, String json) {
    behaviours.put(operationId, new Behaviour(status, json, null, 0));
  }

  /** Throw {@code failure} from {@code operationId}, as a business layer would. */
  public void fail(String operationId, RuntimeException failure) {
    behaviours.put(operationId, new Behaviour(0, null, failure, 0));
  }

  /**
   * Fail {@code operationId} with a domain exception mapping to {@code status}, so the error
   * advice answers with the Problem Details body a real business failure would get.
   */
  public void failWithStatus(String operationId, int status) {
    fail(operationId, new StubbedFailure(status));
  }

  /** Answer like {@link #respond}, but only after {@code delayMillis}. */
  public void delay(String operationId, int status, String json, long delayMillis) {
    behaviours.put(operationId, new Behaviour(status, json, null, delayMillis));
  }

  /** How many times {@code operationId} reached the delegate. */
  public int calls(String operationId) {
    return (int) calls.stream().filter(operationId::equals).count();
  }

  /** A delegate implementation backed by this stub. */
  public <T> T proxy(Class<T> delegateType) {
    InvocationHandler handler = this::invoke;
    Object proxy =
        Proxy.newProxyInstance(
            delegateType.getClassLoader(), new Class<?>[] {delegateType}, handler);
    return delegateType.cast(proxy);
  }

  private Object invoke(Object proxy, Method method, Object[] args) throws Throwable {
    if (method.getDeclaringClass() == Object.class) {
      return switch (method.getName()) {
        case "equals" -> proxy == args[0];
        case "hashCode" -> System.identityHashCode(proxy);
        default -> "O2jDelegateStub";
      };
    }
    if (method.getName().equals("getRequest")) {
      return Optional.empty();
    }
    calls.add(method.getName());
    RequestAttributes request = RequestContextHolder.getRequestAttributes();
    if (request != null) {
      request.setAttribute(STUBBED_ATTRIBUTE, Boolean.TRUE, RequestAttributes.SCOPE_REQUEST);
    }
    Behaviour behaviour = behaviours.get(method.getName());
    if (behaviour == null) {
      return new ResponseEntity<>(HttpStatus.NOT_IMPLEMENTED);
    }
    if (behaviour.delayMillis() > 0) {
      Thread.sleep(behaviour.delayMillis());
    }
    if (behaviour.failure() != null) {
      throw behaviour.failure();
    }
    Object body = null;
    if (behaviour.json() != null) {
      Type bodyType = ((ParameterizedType) method.getGenericReturnType()).getActualTypeArguments()[0];
      body = mapper.readValue(behaviour.json(), mapper.getTypeFactory().constructType(bodyType));
    }
    return ResponseEntity.status(behaviour.status()).body(body);
  }

  /** A business failure with an arbitrary status, for {@link #failWithStatus}. */
  static final class StubbedFailure extends DomainException {

    private static final long serialVersionUID = 1L;

    private final int status;

    StubbedFailure(int status) {
      super(
          HttpStatus.valueOf(status).name().toLowerCase(Locale.ROOT).replace('_', '-'),
          "stubbed failure " + status);
      this.status = status;
    }

    @Override
    public HttpStatus status() {
      return HttpStatus.valueOf(status);
    }
  }
}
