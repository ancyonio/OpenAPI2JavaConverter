/**
 * Keeps TIBCO EMS request/reply consumers working while they migrate to the REST API.
 *
 * <p>GENERATED by o2j. Do not edit: rewritten on every run. The routes come from {@link
 * EmsRoutes}; credentials from {@link EmsBridgeCredentials}, which is yours.
 *
 * <p>For each legacy request queue it listens, turns the message into the HTTP call the spec
 * describes, sends it through the service's own HTTP stack - so security, validation, error
 * mapping and the correlation id all apply exactly as for a direct caller - and replies on
 * {@code JMSReplyTo}:
 *
 * <ul>
 *   <li>body: the HTTP response body;
 *   <li>{@code JMSCorrelationID}: per the route, the request's message id or correlation id;
 *   <li>{@value #STATUS}: the HTTP status, and for errors {@value #FAULT}: the legacy fault
 *       code from the route ({@code HTTP_<status>} if unmapped, {@code TIMEOUT} when the reply
 *       deadline passes, {@code UNAVAILABLE} when the service cannot be reached).
 * </ul>
 *
 * <p>An expired request (past {@code JMSExpiration}) is dropped without a reply, as EMS would.
 * A failure inside the bridge still produces a reply, so a requester is never left waiting.
 *
 * <p>Active only with {@code o2j.ems.enabled=true}, and needs a JMS {@code ConnectionFactory}
 * bean - a TIBCO {@code TibjmsConnectionFactory} in production.
 */
@Configuration
@EnableJms
@ConditionalOnProperty(name = "o2j.ems.enabled", havingValue = "true")
public class EmsBridge implements JmsListenerConfigurer {

  public static final String STATUS = "o2j_status";
  public static final String FAULT = "o2j_fault";

  private static final Logger log = LoggerFactory.getLogger(EmsBridge.class);

  private record Reply(int status, String body, String fault) {}

  private final JmsTemplate jms;
  private final JmsListenerContainerFactory<?> containerFactory;
  private final Environment environment;
  private final ObjectMapper mapper;
  private final EmsBridgeCredentials credentials;
  private final Clock clock;
  private final Map<String, RestClient> clients = new ConcurrentHashMap<>();

  public EmsBridge(
      JmsTemplate jms,
      @Qualifier("jmsListenerContainerFactory") JmsListenerContainerFactory<?> containerFactory,
      Environment environment,
      ObjectMapper mapper,
      EmsBridgeCredentials credentials,
      Clock clock) {
    this.jms = jms;
    this.containerFactory = containerFactory;
    this.environment = environment;
    this.mapper = mapper;
    this.credentials = credentials;
    this.clock = clock;
  }

  @Override
  public void configureJmsListeners(JmsListenerEndpointRegistrar registrar) {
    registrar.setContainerFactory(containerFactory);
    for (EmsRoutes.Route route : EmsRoutes.ALL) {
      SimpleJmsListenerEndpoint endpoint = new SimpleJmsListenerEndpoint();
      endpoint.setId("o2j-ems-" + route.operationId() + "-" + route.destination());
      endpoint.setDestination(route.destination());
      endpoint.setMessageListener(message -> handle(route, message));
      registrar.registerEndpoint(endpoint);
    }
  }

  void handle(EmsRoutes.Route route, Message message) {
    try {
      long expiration = message.getJMSExpiration();
      if (expiration > 0 && expiration < clock.millis()) {
        log.info("dropping expired EMS request on {}", route.destination());
        return;
      }
      Reply reply;
      try {
        reply = forward(route, message);
      } catch (RuntimeException | JMSException | IOException e) {
        log.error("EMS bridge failed for {}", route.destination(), e);
        reply = new Reply(500, null, fault(route, 500));
      }
      send(route, message, reply);
    } catch (JMSException e) {
      // Nothing can be sent back; rethrowing lets the container's redelivery policy decide.
      throw new IllegalStateException("EMS reply failed on " + route.destination(), e);
    }
  }

  private Reply forward(EmsRoutes.Route route, Message message) throws JMSException, IOException {
    String body = message instanceof TextMessage text ? text.getText() : null;
    Map<String, String> pathVariables = new HashMap<>();
    MultiValueMap<String, String> query = new LinkedMultiValueMap<>();
    HttpHeaders headers = new HttpHeaders();
    for (EmsRoutes.Param param : route.params()) {
      String value = resolve(param.source(), message, body);
      if (value == null) {
        continue;
      }
      switch (param.in()) {
        case "path" -> pathVariables.put(param.name(), value);
        case "query" -> query.add(param.name(), value);
        case "header" -> headers.add(param.name(), value);
        default -> log.warn("parameter {} in {} is not bridged", param.name(), param.in());
      }
    }
    headers.set("X-Correlation-ID", correlationId(route, message));
    credentials.bearerToken().ifPresent(headers::setBearerAuth);

    URI uri =
        UriComponentsBuilder.fromUriString(baseUrl())
            .path(route.path())
            .queryParams(query)
            .encode()
            .buildAndExpand(pathVariables)
            .toUri();

    RestClient.RequestBodySpec request =
        client(route)
            .method(HttpMethod.valueOf(route.method()))
            .uri(uri)
            .headers(h -> h.addAll(headers));
    if (route.hasBody() && body != null && !body.isBlank()) {
      request.contentType(MediaType.APPLICATION_JSON).body(body);
    }
    try {
      return request.exchange(
          (req, res) -> {
            int status = res.getStatusCode().value();
            String text = new String(res.getBody().readAllBytes(), StandardCharsets.UTF_8);
            return new Reply(status, text, status >= 400 ? fault(route, status) : null);
          });
    } catch (ResourceAccessException e) {
      boolean timedOut = e.getCause() instanceof HttpTimeoutException;
      int status = timedOut ? 504 : 503;
      log.warn("EMS bridge call for {} failed: {}", route.operationId(), e.getMessage());
      return new Reply(status, null, route.faults().getOrDefault(status, timedOut ? "TIMEOUT" : "UNAVAILABLE"));
    }
  }

  private void send(EmsRoutes.Route route, Message request, Reply reply) throws JMSException {
    Destination replyTo = request.getJMSReplyTo();
    if (replyTo == null) {
      log.warn("EMS request on {} has no JMSReplyTo; reply dropped", route.destination());
      return;
    }
    String correlation = correlationId(route, request);
    jms.send(
        replyTo,
        session -> {
          TextMessage out = session.createTextMessage(reply.body() == null ? "" : reply.body());
          out.setJMSCorrelationID(correlation);
          out.setIntProperty(STATUS, reply.status());
          if (reply.fault() != null) {
            out.setStringProperty(FAULT, reply.fault());
          }
          return out;
        });
  }

  private String resolve(String source, Message message, String body) throws JMSException {
    int colon = source.indexOf(':');
    String kind = source.substring(0, colon);
    String value = source.substring(colon + 1);
    return switch (kind) {
      case "property" -> {
        Object property = message.getObjectProperty(value);
        yield property == null ? null : property.toString();
      }
      case "jms" -> "JMSCorrelationID".equals(value)
          ? message.getJMSCorrelationID()
          : message.getJMSMessageID();
      case "json" -> jsonValue(body, value);
      case "literal" -> value;
      default -> null;
    };
  }

  private String jsonValue(String body, String pointer) {
    if (body == null || body.isBlank()) {
      return null;
    }
    try {
      JsonNode node = mapper.readTree(body).at(pointer);
      return node.isMissingNode() || node.isNull() ? null : node.{{#use_jackson_3}}asString{{/use_jackson_3}}{{^use_jackson_3}}asText{{/use_jackson_3}}();
    } catch (Exception e) {
      log.debug("EMS message body is not JSON; {} not resolved", pointer, e);
      return null;
    }
  }

  private static String correlationId(EmsRoutes.Route route, Message message)
      throws JMSException {
    if (route.correlation() == EmsRoutes.Correlation.CORRELATION_ID
        && message.getJMSCorrelationID() != null) {
      return message.getJMSCorrelationID();
    }
    return message.getJMSMessageID();
  }

  private static String fault(EmsRoutes.Route route, int status) {
    return route.faults().getOrDefault(status, "HTTP_" + status);
  }

  private RestClient client(EmsRoutes.Route route) {
    return clients.computeIfAbsent(
        route.destination(),
        destination -> {
          Duration timeout = Duration.ofMillis(route.replyTimeoutMillis());
          HttpClient http = HttpClient.newBuilder().connectTimeout(timeout).build();
          JdkClientHttpRequestFactory factory = new JdkClientHttpRequestFactory(http);
          factory.setReadTimeout(timeout);
          return RestClient.builder().requestFactory(factory).build();
        });
  }

  private String baseUrl() {
    String configured = environment.getProperty("o2j.ems.target-base-url");
    if (configured != null && !configured.isBlank()) {
      return configured;
    }
    String port =
        environment.getProperty("local.server.port", environment.getProperty("server.port", "8080"));
    return "http://localhost:" + port;
  }
}
