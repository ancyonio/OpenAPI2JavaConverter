package {{base_package}}.config;

import java.time.Instant;
import java.util.Map;

/**
 * Where {@link IdempotencyFilter} remembers which {@code Idempotency-Key} produced which
 * response.
 *
 * <p>GENERATED by o2j. Do not edit: rewritten on every run.
 *
 * <p>The default, {@link InMemoryIdempotencyStore}, is correct for a single instance only. With
 * more than one replica a retry can land on an instance that has never seen the key, so declare
 * your own {@code IdempotencyStore} bean backed by something shared (a database table with a
 * unique key, or Redis {@code SET NX}). The filter uses it in preference to the default.
 * Implementations must make {@link #claim} atomic: two concurrent requests with one key must
 * not both be {@link Outcome#ACQUIRED}.
 */
public interface IdempotencyStore {

  /** What {@link #claim} found for a key. */
  enum Outcome {
    /** First use (or the previous one expired): the caller must run the request. */
    ACQUIRED,
    /** Another request with the same key and payload is still running. */
    IN_PROGRESS,
    /** The same request already completed; replay {@link Claim#response()}. */
    REPLAY,
    /** The key was used for a different request. */
    MISMATCH
  }

  /** A completed response, as it will be replayed. */
  record StoredResponse(int status, String contentType, Map<String, String> headers, byte[] body) {
    public StoredResponse {
      headers = Map.copyOf(headers);
      body = body.clone();
    }

    @Override
    public byte[] body() {
      return body.clone();
    }
  }

  /** The outcome, and for {@link Outcome#REPLAY} the stored response. */
  record Claim(Outcome outcome, StoredResponse response) {}

  /** Atomically reserve {@code key} for a request identified by {@code fingerprint}. */
  Claim claim(String key, String fingerprint, Instant now);

  /** Record the response for a key previously {@link Outcome#ACQUIRED}. */
  void complete(String key, StoredResponse response, Instant now);

  /** Give up a reservation that did not complete, so the client can retry. */
  void release(String key);
}
