package {{base_package}}.config;

import java.time.Duration;
import java.time.Instant;
import java.util.Map;
import java.util.concurrent.ConcurrentHashMap;

/**
 * Single-instance {@link IdempotencyStore}: keys live in memory for the configured TTL
 * ({@code o2j.idempotency.ttl}, default 24 hours).
 *
 * <p>GENERATED by o2j. Do not edit: rewritten on every run. See {@link IdempotencyStore} for
 * when to replace it.
 */
public final class InMemoryIdempotencyStore implements IdempotencyStore {

  /** Above this many keys, expired ones are swept on the next claim. */
  private static final int SWEEP_THRESHOLD = 10_000;

  private record Entry(String fingerprint, StoredResponse response, Instant expiresAt) {
    boolean expiredAt(Instant now) {
      return !expiresAt.isAfter(now);
    }
  }

  private final Map<String, Entry> entries = new ConcurrentHashMap<>();
  private final Duration ttl;

  public InMemoryIdempotencyStore(Duration ttl) {
    this.ttl = ttl;
  }

  @Override
  public Claim claim(String key, String fingerprint, Instant now) {
    Claim[] result = new Claim[1];
    entries.compute(
        key,
        (k, existing) -> {
          if (existing == null || existing.expiredAt(now)) {
            result[0] = new Claim(Outcome.ACQUIRED, null);
            return new Entry(fingerprint, null, now.plus(ttl));
          }
          if (!existing.fingerprint().equals(fingerprint)) {
            result[0] = new Claim(Outcome.MISMATCH, null);
          } else if (existing.response() == null) {
            result[0] = new Claim(Outcome.IN_PROGRESS, null);
          } else {
            result[0] = new Claim(Outcome.REPLAY, existing.response());
          }
          return existing;
        });
    if (entries.size() > SWEEP_THRESHOLD) {
      entries.values().removeIf(entry -> entry.expiredAt(now));
    }
    return result[0];
  }

  @Override
  public void complete(String key, StoredResponse response, Instant now) {
    entries.computeIfPresent(
        key, (k, entry) -> new Entry(entry.fingerprint(), response, now.plus(ttl)));
  }

  @Override
  public void release(String key) {
    entries.computeIfPresent(key, (k, entry) -> entry.response() == null ? null : entry);
  }
}
