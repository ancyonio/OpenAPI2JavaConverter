package {{base_package}}.config;

import static org.assertj.core.api.Assertions.assertThat;

import {{base_package}}.error.DomainException;
import jakarta.servlet.http.HttpServlet;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import java.io.IOException;
import java.nio.charset.StandardCharsets;
import java.time.Clock;
import java.time.Duration;
import java.time.Instant;
import java.time.ZoneOffset;
import java.util.concurrent.atomic.AtomicInteger;
import org.junit.jupiter.api.Test;
import org.springframework.http.HttpHeaders;
import org.springframework.mock.web.MockFilterChain;
import org.springframework.mock.web.MockHttpServletRequest;
import org.springframework.mock.web.MockHttpServletResponse;
import org.springframework.web.servlet.ModelAndView;

/**
 * The idempotency mechanism itself, on {@code {{idempotency_sample_method}}
 * {{idempotency_sample_path}}}.
 *
 * <p>GENERATED by o2j. Do not edit: rewritten on every run. Drives the filter directly with a
 * counting handler, so "exactly one side effect" is asserted, not assumed.
 */
class IdempotencyFilterTest {

  private static final String METHOD = "{{idempotency_sample_method}}";
  private static final String PATH = "{{idempotency_sample_path}}";
  private static final String BODY = "{\"value\":1}";
  private static final Instant NOW = Instant.parse("2026-01-15T10:15:30Z");

  private final InMemoryIdempotencyStore store = new InMemoryIdempotencyStore(Duration.ofHours(1));
  private final IdempotencyFilter filter =
      new IdempotencyFilter(store, Clock.fixed(NOW, ZoneOffset.UTC), IdempotencyFilterTest::resolve);
  private final AtomicInteger calls = new AtomicInteger();

  @Test
  void doFilter_repeatedKeyAndRequest_replaysWithoutCallingTheHandlerAgain() throws Exception {
    MockHttpServletResponse first = send(PATH, "key-1", BODY, handler(201));
    MockHttpServletResponse second = send(PATH, "key-1", BODY, handler(201));

    assertThat(calls).hasValue(1);
    assertThat(second.getStatus()).isEqualTo(201);
    assertThat(second.getContentAsString()).isEqualTo(first.getContentAsString());
    assertThat(second.getHeader(HttpHeaders.LOCATION)).isEqualTo(first.getHeader(HttpHeaders.LOCATION));
    assertThat(second.getHeader(IdempotencyFilter.REPLAYED_HEADER)).isEqualTo("true");
    assertThat(first.getHeader(IdempotencyFilter.REPLAYED_HEADER)).isNull();
  }

  @Test
  void doFilter_handlerReadsTheBody_afterItWasFingerprinted() throws Exception {
    MockHttpServletResponse response = send(PATH, "key-1", BODY, handler(201));

    assertThat(response.getContentAsString()).contains(BODY);
  }

  @Test
  void doFilter_sameKeyDifferentBody_is422AndHandlerNotCalled() throws Exception {
    send(PATH, "key-1", BODY, handler(201));
    MockHttpServletResponse reused = send(PATH, "key-1", "{\"value\":2}", handler(201));

    assertThat(reused.getStatus()).isEqualTo(422);
    assertThat(calls).hasValue(1);
  }

  @Test
  void doFilter_sameKeyWhileFirstStillRunning_is409() throws Exception {
    MockHttpServletResponse[] concurrent = new MockHttpServletResponse[1];
    HttpServlet reentrant =
        new HttpServlet() {
          private static final long serialVersionUID = 1L;

          @Override
          protected void service(HttpServletRequest request, HttpServletResponse response)
              throws IOException {
            try {
              concurrent[0] = send(PATH, "key-1", BODY, handler(201));
            } catch (Exception e) {
              throw new IOException(e);
            }
            response.setStatus(201);
          }
        };

    MockHttpServletResponse first = send(PATH, "key-1", BODY, reentrant);

    assertThat(first.getStatus()).isEqualTo(201);
    assertThat(concurrent[0].getStatus()).isEqualTo(409);
    assertThat(calls).hasValue(0);
  }

  @Test
  void doFilter_failedResponse_isNotStoredSoARetryRunsAgain() throws Exception {
    send(PATH, "key-1", BODY, handler(503));
    MockHttpServletResponse retry = send(PATH, "key-1", BODY, handler(201));

    assertThat(retry.getStatus()).isEqualTo(201);
    assertThat(retry.getHeader(IdempotencyFilter.REPLAYED_HEADER)).isNull();
    assertThat(calls).hasValue(2);
  }

  @Test
  void doFilter_withoutKey_passesThroughEveryTime() throws Exception {
    send(PATH, null, BODY, handler(201));
    send(PATH, null, BODY, handler(201));

    assertThat(calls).hasValue(2);
  }

  @Test
  void doFilter_operationWithoutIdempotencyKeyInSpec_passesThrough() throws Exception {
    send("/o2j-not-an-idempotent-operation", "key-1", BODY, handler(201));
    send("/o2j-not-an-idempotent-operation", "key-1", BODY, handler(201));

    assertThat(calls).hasValue(2);
  }

  @Test
  void claim_afterTtl_acquiresAgain() {
    store.claim("key", "fingerprint", NOW);
    store.complete("key", new IdempotencyStore.StoredResponse(201, null, java.util.Map.of(), new byte[0]), NOW);

    assertThat(store.claim("key", "fingerprint", NOW.plus(Duration.ofMinutes(59))).outcome())
        .isEqualTo(IdempotencyStore.Outcome.REPLAY);
    assertThat(store.claim("key", "fingerprint", NOW.plus(Duration.ofHours(2))).outcome())
        .isEqualTo(IdempotencyStore.Outcome.ACQUIRED);
  }

  private MockHttpServletResponse send(String path, String key, String body, HttpServlet handler)
      throws Exception {
    MockHttpServletRequest request = new MockHttpServletRequest(METHOD, path);
    if (key != null) {
      request.addHeader(IdempotencyFilter.HEADER, key);
    }
    request.setContentType("application/json");
    request.setContent(body.getBytes(StandardCharsets.UTF_8));
    MockHttpServletResponse response = new MockHttpServletResponse();
    filter.doFilter(request, response, new MockFilterChain(handler));
    return response;
  }

  /** Counts each call and echoes the body it read, with a per-call Location. */
  private HttpServlet handler(int status) {
    return new HttpServlet() {
      private static final long serialVersionUID = 1L;

      @Override
      protected void service(HttpServletRequest request, HttpServletResponse response)
          throws IOException {
        int call = calls.incrementAndGet();
        String echoed = new String(request.getInputStream().readAllBytes(), StandardCharsets.UTF_8);
        response.setStatus(status);
        response.setContentType("application/json");
        response.setHeader(HttpHeaders.LOCATION, "/created/" + call);
        response.getWriter().write("{\"call\":" + call + ",\"echo\":" + echoed + "}");
      }
    };
  }

  /** Stands in for the MVC resolver: maps the domain exception to its status. */
  private static ModelAndView resolve(
      HttpServletRequest request, HttpServletResponse response, Object handler, Exception exception) {
    response.setStatus(((DomainException) exception).status().value());
    return new ModelAndView();
  }
}
