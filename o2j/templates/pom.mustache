<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>{{spring_boot_version}}</version>
    <relativePath/>
  </parent>

  <groupId>{{group_id}}</groupId>
  <artifactId>{{artifact_id}}</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>{{service_name}}</name>

  <properties>
    <java.version>{{java_version}}</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <openapi-generator.version>{{versions.openapi_generator}}</openapi-generator.version>
    <mapstruct.version>{{versions.mapstruct}}</mapstruct.version>
    <springdoc.version>{{versions.springdoc}}</springdoc.version>
    <archunit.version>{{versions.archunit}}</archunit.version>
    <jacoco.version>{{versions.jacoco}}</jacoco.version>
    <pitest.version>{{versions.pitest}}</pitest.version>
    <pitest-junit5.version>{{versions.pitest_junit5}}</pitest-junit5.version>
    <spotless.version>{{versions.spotless}}</spotless.version>
    <checkstyle.version>{{versions.checkstyle}}</checkstyle.version>
    <pmd.version>{{versions.pmd}}</pmd.version>
    <spotbugs.version>{{versions.spotbugs}}</spotbugs.version>
    <testcontainers.version>{{versions.testcontainers}}</testcontainers.version>
    <dependency-check.version>{{versions.owasp_dependency_check}}</dependency-check.version>
    <cyclonedx.version>{{versions.cyclonedx}}</cyclonedx.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <!-- @Transactional lives here. Without a persistence starter nothing else brings it in,
         and the ArchitectureTest rules about transaction boundaries would not compile. -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-tx</artifactId>
    </dependency>

    <!-- springdoc serves the generated OpenAPI document at runtime -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <!-- Swagger annotations referenced by the generated models -->
    <dependency>
      <groupId>io.swagger.core.v3</groupId>
      <artifactId>swagger-annotations</artifactId>
      <version>2.2.25</version>
    </dependency>
    <dependency>
      <groupId>jakarta.annotation</groupId>
      <artifactId>jakarta.annotation-api</artifactId>
    </dependency>

    <!-- MapStruct: DTO <-> domain. unmappedTargetPolicy=ERROR (set in mapper/MapStructConfig,
         not as a compiler flag) turns a silently dropped field after a spec change into a
         compile failure, which is the cheapest place to catch it. -->
    <dependency>
      <groupId>org.mapstruct</groupId>
      <artifactId>mapstruct</artifactId>
      <version>${mapstruct.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- S4: the contract layer. Reproducible by construction - hideGenerationTimestamp
           must stay true or the determinism gate fails. -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>${openapi-generator.version}</version>
        <executions>
          <execution>
            <id>generate-api</id>
            <goals><goal>generate</goal></goals>
            <configuration>
              <inputSpec>${project.basedir}/openapi/spec.canonical.yaml</inputSpec>
              <generatorName>spring</generatorName>
              <library>spring-boot</library>
              <output>${project.build.directory}/generated-sources/openapi</output>
              <apiPackage>{{base_package}}.api</apiPackage>
              <modelPackage>{{base_package}}.api.model</modelPackage>
              <!-- Generated test stubs assert nothing while inflating the coverage
                   denominator, which would make the coverage gate meaningless. -->
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelDocumentation>false</generateModelDocumentation>
              <!-- Only the supporting files the contract layer needs. The default set adds a
                   second @SpringBootApplication (org.openapitools.OpenApiGeneratorApplication),
                   which breaks repackaging, plus config in a package nothing scans. -->
              <supportingFilesToGenerate>ApiUtil.java,EnumConverterConfiguration.java</supportingFilesToGenerate>
              <configOptions>
{{#use_spring_boot_4}}                <useSpringBoot4>true</useSpringBoot4>
                <useJackson3>true</useJackson3>
{{/use_spring_boot_4}}{{^use_spring_boot_4}}                <useSpringBoot3>true</useSpringBoot3>
{{/use_spring_boot_4}}                <delegatePattern>{{generation.delegate_pattern}}</delegatePattern>
                <interfaceOnly>{{generation.interface_only}}</interfaceOnly>
                <useTags>{{generation.use_tags}}</useTags>
                <documentationProvider>{{generation.documentation_provider}}</documentationProvider>
                <annotationLibrary>{{generation.annotation_library}}</annotationLibrary>
                <useBeanValidation>{{generation.use_bean_validation}}</useBeanValidation>
                <performBeanValidation>{{generation.perform_bean_validation}}</performBeanValidation>
                <useOptional>{{generation.use_optional}}</useOptional>
                <openApiNullable>{{generation.open_api_nullable}}</openApiNullable>
                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                <serializableModel>{{generation.serializable_model}}</serializableModel>
                <unhandledException>{{generation.unhandled_exception}}</unhandledException>
                <sourceFolder>src/main/java</sourceFolder>
                <configPackage>{{base_package}}.config.openapi</configPackage>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.mapstruct</groupId>
              <artifactId>mapstruct-processor</artifactId>
              <version>${mapstruct.version}</version>
            </path>
          </annotationProcessorPaths>
          <compilerArgs>
            <arg>-Werror</arg>
            <arg>-Xlint:all,-processing</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>{{base_package}}.Application</mainClass>
        </configuration>
      </plugin>

      <!-- S7: coverage. Generated code is excluded - coverage of a generated getter
           measures the generator, not this service. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <configuration>
          <excludes>
{{#coverage_excludes}}            <exclude>{{pattern}}</exclude>
{{/coverage_excludes}}          </excludes>
        </configuration>
        <executions>
          <execution><goals><goal>prepare-agent</goal></goals></execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <execution>
            <id>check</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.{{coverage.line_min}}</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.{{coverage.branch_min}}</minimum>
                    </limit>
                  </limits>
                </rule>
                <rule>
                  <element>PACKAGE</element>
                  <includes><include>*.service.*</include></includes>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.{{coverage.service_layer_line_min}}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- S7: mutation testing. This, not line coverage, is what distinguishes a test
           that asserts the right outcome from one that asserts nothing. -->
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <version>${pitest.version}</version>
        <dependencies>
          <dependency>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-junit5-plugin</artifactId>
            <version>${pitest-junit5.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <targetClasses><param>{{mutation_target}}</param></targetClasses>
          <targetTests><param>{{base_package}}.service.*Test</param></targetTests>
          <mutationThreshold>{{mutation.threshold}}</mutationThreshold>
          <coverageThreshold>{{mutation.coverage_threshold}}</coverageThreshold>
          <timestampedReports>false</timestampedReports>
          <outputFormats>
            <outputFormat>XML</outputFormat>
            <outputFormat>HTML</outputFormat>
          </outputFormats>
        </configuration>
      </plugin>

      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <googleJavaFormat/>
            <removeUnusedImports/>
            <trimTrailingWhitespace/>
            <endWithNewline/>
            <includes><include>src/**/*.java</include></includes>
          </java>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>${checkstyle.version}</version>
        <configuration>
          <includeTestSourceDirectory>true</includeTestSourceDirectory>
          <sourceDirectories><sourceDirectory>src/main/java</sourceDirectory></sourceDirectories>
          <failOnViolation>true</failOnViolation>
          <violationSeverity>warning</violationSeverity>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
        <version>${pmd.version}</version>
        <configuration>
          <failurePriority>2</failurePriority>
          <excludeRoots>
            <excludeRoot>${project.build.directory}/generated-sources</excludeRoot>
          </excludeRoots>
        </configuration>
      </plugin>

      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <version>${spotbugs.version}</version>
        <configuration>
          <effort>Max</effort>
          <threshold>Medium</threshold>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.owasp</groupId>
        <artifactId>dependency-check-maven</artifactId>
        <version>${dependency-check.version}</version>
        <configuration>
          <failBuildOnCVSS>7</failBuildOnCVSS>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.cyclonedx</groupId>
        <artifactId>cyclonedx-maven-plugin</artifactId>
        <version>${cyclonedx.version}</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>makeAggregateBom</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
