package {{base_package}}.ems;

import static org.assertj.core.api.Assertions.assertThat;
import static org.assertj.core.api.Assertions.assertThatThrownBy;

import com.sun.net.httpserver.HttpServer;
import java.io.IOException;
import java.net.InetAddress;
import java.net.InetSocketAddress;
import java.nio.charset.StandardCharsets;
import java.time.Clock;
import java.time.Duration;
import java.time.Instant;
import java.time.ZoneId;
import java.time.ZoneOffset;
import java.util.Base64;
import java.util.List;
import java.util.concurrent.CopyOnWriteArrayList;
import org.junit.jupiter.api.AfterEach;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.springframework.mock.env.MockEnvironment;
import org.springframework.web.client.RestClientResponseException;

/**
 * How the EMS bridge obtains its bearer token.
 *
 * <p>Scaffolded once by o2j; yours to edit and never overwritten. A local HTTP server stands in
 * for the token endpoint, so the grant, the client authentication and the caching are checked
 * against real HTTP rather than a mock of the client.
 */
class EmsBridgeCredentialsTest {

  private static final Instant NOW = Instant.parse("2026-01-15T10:15:30Z");

  private final MovableClock clock = new MovableClock(NOW);
  private final List<String> requests = new CopyOnWriteArrayList<>();
  private final MockEnvironment environment = new MockEnvironment();
  private HttpServer server;
  private volatile int status = 200;

  @BeforeEach
  void startTokenEndpoint() throws IOException {
    server = HttpServer.create(new InetSocketAddress(InetAddress.getLoopbackAddress(), 0), 0);
    server.createContext(
        "/token",
        exchange -> {
          String form = new String(exchange.getRequestBody().readAllBytes(), StandardCharsets.UTF_8);
          requests.add(exchange.getRequestHeaders().getFirst("Authorization") + " " + form);
          byte[] body =
              ("{\"access_token\":\"token-" + requests.size() + "\",\"expires_in\":120}")
                  .getBytes(StandardCharsets.UTF_8);
          exchange.getResponseHeaders().add("Content-Type", "application/json");
          exchange.sendResponseHeaders(status, body.length);
          exchange.getResponseBody().write(body);
          exchange.close();
        });
    server.start();
    environment
        .withProperty(
            "o2j.ems.oauth2.token-uri",
            "http://localhost:" + server.getAddress().getPort() + "/token")
        .withProperty("o2j.ems.oauth2.client-id", "ems-bridge")
        .withProperty("o2j.ems.oauth2.client-secret", "s3cret")
        .withProperty("o2j.ems.oauth2.scope", "orders:read");
  }

  @AfterEach
  void stopTokenEndpoint() {
    server.stop(0);
  }

  @Test
  void bearerToken_clientCredentials_authenticatesTheClientAndSendsTheGrant() {
    assertThat(new EmsBridgeCredentials(environment, clock).bearerToken()).contains("token-1");

    String basic =
        Base64.getEncoder().encodeToString("ems-bridge:s3cret".getBytes(StandardCharsets.UTF_8));
    assertThat(requests).hasSize(1);
    assertThat(requests.get(0))
        .startsWith("Basic " + basic)
        .contains("grant_type=client_credentials")
        .contains("scope=orders%3Aread");
  }

  @Test
  void bearerToken_beforeExpiry_reusesTheCachedToken() {
    EmsBridgeCredentials credentials = new EmsBridgeCredentials(environment, clock);
    credentials.bearerToken();
    clock.advance(Duration.ofSeconds(120).minus(EmsBridgeCredentials.EXPIRY_MARGIN).minusSeconds(1));

    assertThat(credentials.bearerToken()).contains("token-1");
    assertThat(requests).hasSize(1);
  }

  @Test
  void bearerToken_nearExpiry_fetchesANewToken() {
    EmsBridgeCredentials credentials = new EmsBridgeCredentials(environment, clock);
    credentials.bearerToken();
    clock.advance(Duration.ofSeconds(120).minus(EmsBridgeCredentials.EXPIRY_MARGIN));

    assertThat(credentials.bearerToken()).contains("token-2");
    assertThat(requests).hasSize(2);
  }

  @Test
  void bearerToken_tokenEndpointRefuses_throwsSoTheBridgeRepliesWithAFault() {
    status = 400; // invalid_client / invalid_scope
    EmsBridgeCredentials credentials = new EmsBridgeCredentials(environment, clock);

    assertThatThrownBy(credentials::bearerToken).isInstanceOf(RestClientResponseException.class);
  }

  @Test
  void bearerToken_tokenUriWithoutClientSecret_failsNamingTheMissingProperty() {
    environment.setProperty("o2j.ems.oauth2.client-secret", "");
    EmsBridgeCredentials credentials = new EmsBridgeCredentials(environment, clock);

    assertThatThrownBy(credentials::bearerToken).hasMessageContaining("client-secret");
  }

  @Test
  void bearerToken_noTokenUri_fallsBackToTheStaticToken() {
    MockEnvironment plain = new MockEnvironment().withProperty("o2j.ems.bearer-token", "static");

    assertThat(new EmsBridgeCredentials(plain, clock).bearerToken()).contains("static");
    assertThat(new EmsBridgeCredentials(new MockEnvironment(), clock).bearerToken()).isEmpty();
  }

  /** A clock the test moves forward. */
  private static final class MovableClock extends Clock {

    private Instant now;

    MovableClock(Instant now) {
      this.now = now;
    }

    void advance(Duration duration) {
      now = now.plus(duration);
    }

    @Override
    public ZoneId getZone() {
      return ZoneOffset.UTC;
    }

    @Override
    public Clock withZone(ZoneId zone) {
      return this;
    }

    @Override
    public Instant instant() {
      return now;
    }
  }
}
