# Generated once by o2j; safe to edit.
spring:
  application:
    name: {{service_name}}
{{#virtual_threads}}
  threads:
    virtual:
      enabled: true          # Java {{java_version}}: one platform thread per CPU, not per request
{{/virtual_threads}}
  jackson:
    default-property-inclusion: non_null
    deserialization:
      fail-on-unknown-properties: true   # an unexpected field is a contract mismatch, not noise
  mvc:
    problemdetails:
      enabled: true          # RFC 9457 for framework-raised errors too
{{#uses_jwt}}
  security:
    oauth2:
      resourceserver:
        jwt:
          # Set JWT_ISSUER_URI per environment. The default cannot resolve, so an unconfigured
          # service rejects every token (fails closed) rather than trusting one. Spring Boot
          # resolves the issuer lazily, so startup and tests do not need it to be reachable.
          issuer-uri: ${JWT_ISSUER_URI:https://issuer.invalid}
{{/uses_jwt}}
  jpa:
    hibernate:
      ddl-auto: validate     # schema changes go through Flyway, never through Hibernate

server:
  error:
    include-stacktrace: never
    include-message: never   # messages can carry internal detail; the advice decides what to say
  shutdown: graceful

management:
  endpoints:
    web:
      exposure:
        include: health,info,prometheus
  endpoint:
    health:
      probes:
        enabled: true
  metrics:
    tags:
      application: {{service_name}}

springdoc:
  swagger-ui:
    path: /swagger-ui.html
  api-docs:
    path: /v3/api-docs

logging:
  pattern:
    # correlationId ties a caller's error response back to these lines
    level: "%5p [${spring.application.name:},%X{correlationId:-}]"

o2j:
  spec-hash: {{spec_hash}}
  operations: {{operation_count}}
{{#ems_enabled}}
  ems:
    # The TIBCO EMS bridge (EmsBridge). Enable it where the legacy request queues must keep
    # being served; it needs a JMS ConnectionFactory bean (TibjmsConnectionFactory).
    enabled: ${O2J_EMS_ENABLED:false}
    # Where the bridge sends HTTP calls. Defaults to this instance.
    # target-base-url: http://localhost:8080
    # The bridge's own bearer token; from a secret, never in this file.
    bearer-token: ${O2J_EMS_BEARER_TOKEN:}
{{/ems_enabled}}
