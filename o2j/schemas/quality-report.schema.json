{
  "$defs": {
    "Gate": {
      "additionalProperties": false,
      "properties": {
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "failedOn": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failedon"
        }
      },
      "required": [
        "passed"
      ],
      "title": "Gate",
      "type": "object"
    },
    "ToolResult": {
      "additionalProperties": false,
      "properties": {
        "tool": {
          "title": "Tool",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "skipped",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "findings": {
          "default": 0,
          "title": "Findings",
          "type": "integer"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        }
      },
      "required": [
        "tool",
        "status"
      ],
      "title": "ToolResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "generatedAt": {
      "title": "Generatedat",
      "type": "string"
    },
    "tools": {
      "items": {
        "$ref": "#/$defs/ToolResult"
      },
      "title": "Tools",
      "type": "array"
    },
    "gate": {
      "$ref": "#/$defs/Gate"
    }
  },
  "required": [
    "gate"
  ],
  "title": "QualityReport",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://o2j.dev/schemas/quality-report.schema.json"
}
